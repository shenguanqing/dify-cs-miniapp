# ===== 服务端口 =====
PORT=3000
# 接口统一前缀
API_PREFIX=api

# ===== Dify 配置（你已在本地 Docker 部署）=====
# Dify 应用 API 地址。本机 Docker 默认：http://localhost/v1
# 若后端与 Dify 在同一台机器的不同容器，请用 http://<dify容器名或网关IP>/v1
DIFY_API_BASE_URL=http://localhost/v1
# 在 Dify 应用「访问 API」页面生成的 App API Key（app-xxxx）
DIFY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# 请求超时（毫秒）
DIFY_TIMEOUT=60000

# ===== 微信小程序登录 =====
WX_APPID=your_wx_appid
WX_SECRET=your_wx_secret

# ===== JWT =====
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ===== 数据库（TypeORM）=====
# 类型：postgres 或 mysql
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=ai_customer_service
# 开发期可设 true 自动建表；生产请用迁移并设为 false
DB_SYNCHRONIZE=false

# ===== 限流（每个时间窗口内允许的请求数）=====
THROTTLE_TTL=60
THROTTLE_LIMIT=30

# ===== 敏感词（逗号分隔，可留空）=====
SENSITIVE_WORDS=
